<?xml version="1.0" encoding="utf-8"?>
<widget
    id="com.mendix.axganttchart.AxGanttChart"
    pluginWidget="true"
    offlineCapable="true"
    xmlns="http://www.mendix.com/widget/1.0/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd"
>
    <name>Ax Gantt Chart</name>
    <description>Enterprise Gantt chart widget powered by DHTMLX Gantt</description>
    <icon />
    <properties>
        <propertyGroup caption="General">
            <property key="height" type="integer" required="true" defaultValue="600">
                <caption>Height</caption>
                <description>Gantt widget height in pixels</description>
            </property>
            <property key="defaultViewMode" type="enumeration" required="true" defaultValue="month">
                <caption>Default view mode</caption>
                <description>Initial timeline scale granularity</description>
                <enumerationValues>
                    <enumerationValue key="day">Day</enumerationValue>
                    <enumerationValue key="week">Week</enumerationValue>
                    <enumerationValue key="month">Month</enumerationValue>
                </enumerationValues>
            </property>
        </propertyGroup>
        <propertyGroup caption="Display">
            <property key="showToolbar" type="boolean" required="true" defaultValue="true">
                <caption>Show toolbar</caption>
                <description>Display built-in view mode and action toolbar</description>
            </property>
            <property key="showGrid" type="boolean" required="true" defaultValue="true">
                <caption>Show grid</caption>
                <description>Display task grid panel</description>
            </property>
            <property key="showTimeline" type="boolean" required="true" defaultValue="true">
                <caption>Show timeline</caption>
                <description>Display timeline panel</description>
            </property>
            <property key="showProgress" type="boolean" required="true" defaultValue="false">
                <caption>Show progress</caption>
                <description>Display progress bars on tasks</description>
            </property>
            <property key="showTodayMarker" type="boolean" required="true" defaultValue="true">
                <caption>Show today marker</caption>
                <description>Display vertical marker for current date</description>
            </property>
        </propertyGroup>
        <propertyGroup caption="Data Source">
            <property key="tasksDatasource" type="datasource" isList="true" required="true">
                <caption>Data source</caption>
                <description>List datasource returning task objects from database, microflow, nanoflow, or REST integration</description>
            </property>
            <property key="idAttribute" type="attribute" dataSource="tasksDatasource" required="true">
                <caption>ID attribute</caption>
                <description>Unique task identifier</description>
                <attributeTypes>
                    <attributeType name="String" />
                    <attributeType name="AutoNumber" />
                </attributeTypes>
            </property>
            <property key="textAttribute" type="attribute" dataSource="tasksDatasource" required="true">
                <caption>Text attribute</caption>
                <description>Task label displayed in grid and timeline</description>
                <attributeTypes>
                    <attributeType name="String" />
                </attributeTypes>
            </property>
            <property key="startDateAttribute" type="attribute" dataSource="tasksDatasource" required="true">
                <caption>Start date attribute</caption>
                <description>Task start date</description>
                <attributeTypes>
                    <attributeType name="DateTime" />
                </attributeTypes>
            </property>
            <property key="endDateAttribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>End date attribute</caption>
                <description>Task end date (optional if duration is provided)</description>
                <attributeTypes>
                    <attributeType name="DateTime" />
                </attributeTypes>
            </property>
            <property key="durationAttribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>Duration attribute</caption>
                <description>Task duration in days (optional if end date is provided)</description>
                <attributeTypes>
                    <attributeType name="Integer" />
                    <attributeType name="Long" />
                    <attributeType name="Decimal" />
                </attributeTypes>
            </property>
            <property key="progressAttribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>Progress attribute</caption>
                <description>Task completion from 0 to 1</description>
                <attributeTypes>
                    <attributeType name="Decimal" />
                    <attributeType name="Integer" />
                </attributeTypes>
            </property>
            <property key="parentAttribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>Parent attribute</caption>
                <description>Parent task ID for hierarchy</description>
                <attributeTypes>
                    <attributeType name="String" />
                    <attributeType name="AutoNumber" />
                </attributeTypes>
            </property>
            <property key="orderNoAttribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>Order number attribute</caption>
                <description>Sibling sort order within the same parent (lower values appear first)</description>
                <attributeTypes>
                    <attributeType name="Integer" />
                    <attributeType name="Long" />
                    <attributeType name="Decimal" />
                </attributeTypes>
            </property>
            <property key="openAttribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>Open attribute</caption>
                <description>Whether child tasks are expanded</description>
                <attributeTypes>
                    <attributeType name="Boolean" />
                </attributeTypes>
            </property>
            <property key="typeAttribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>Type attribute</caption>
                <description>DHTMLX task type (task, project, milestone)</description>
                <attributeTypes>
                    <attributeType name="String" />
                    <attributeType name="Enum" />
                </attributeTypes>
            </property>
            <property key="tagsAttribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>Tags attribute</caption>
                <description>JSON array or comma-separated labels (e.g. Manual, Process)</description>
                <attributeTypes>
                    <attributeType name="String" />
                </attributeTypes>
            </property>
            <property key="mtoDateAttribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>Milestone date attribute</caption>
                <description>MTO/K/O milestone date on the timeline (MTO = midpoint, K/O = bar start)</description>
                <attributeTypes>
                    <attributeType name="DateTime" />
                </attributeTypes>
            </property>
            <property key="eventTypeAttribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>Event type attribute</caption>
                <description>Event marker type: MTO or K/O</description>
                <attributeTypes>
                    <attributeType name="String" />
                    <attributeType name="Enum" />
                </attributeTypes>
            </property>
            <property key="metadata1Attribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>Metadata 1 attribute</caption>
                <description>Optional value stored in task metadata.metadata1</description>
                <attributeTypes>
                    <attributeType name="String" />
                    <attributeType name="Integer" />
                    <attributeType name="Long" />
                    <attributeType name="Decimal" />
                    <attributeType name="Boolean" />
                    <attributeType name="Enum" />
                    <attributeType name="DateTime" />
                </attributeTypes>
            </property>
            <property key="metadata2Attribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>Metadata 2 attribute</caption>
                <description>Optional value stored in task metadata.metadata2</description>
                <attributeTypes>
                    <attributeType name="String" />
                    <attributeType name="Integer" />
                    <attributeType name="Long" />
                    <attributeType name="Decimal" />
                    <attributeType name="Boolean" />
                    <attributeType name="Enum" />
                    <attributeType name="DateTime" />
                </attributeTypes>
            </property>
            <property key="metadata3Attribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>Metadata 3 attribute</caption>
                <description>Optional value stored in task metadata.metadata3</description>
                <attributeTypes>
                    <attributeType name="String" />
                    <attributeType name="Integer" />
                    <attributeType name="Long" />
                    <attributeType name="Decimal" />
                    <attributeType name="Boolean" />
                    <attributeType name="Enum" />
                    <attributeType name="DateTime" />
                </attributeTypes>
            </property>
            <property key="metadata4Attribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>Metadata 4 attribute</caption>
                <description>Optional value stored in task metadata.metadata4</description>
                <attributeTypes>
                    <attributeType name="String" />
                    <attributeType name="Integer" />
                    <attributeType name="Long" />
                    <attributeType name="Decimal" />
                    <attributeType name="Boolean" />
                    <attributeType name="Enum" />
                    <attributeType name="DateTime" />
                </attributeTypes>
            </property>
            <property key="metadata5Attribute" type="attribute" dataSource="tasksDatasource" required="false">
                <caption>Metadata 5 attribute</caption>
                <description>Optional value stored in task metadata.metadata5</description>
                <attributeTypes>
                    <attributeType name="String" />
                    <attributeType name="Integer" />
                    <attributeType name="Long" />
                    <attributeType name="Decimal" />
                    <attributeType name="Boolean" />
                    <attributeType name="Enum" />
                    <attributeType name="DateTime" />
                </attributeTypes>
            </property>
        </propertyGroup>
        <propertyGroup caption="Editing">
            <property key="allowDrag" type="boolean" required="true" defaultValue="true">
                <caption>Allow drag</caption>
                <description>Allow dragging tasks on the timeline</description>
            </property>
            <property key="allowResize" type="boolean" required="true" defaultValue="false">
                <caption>Allow resize</caption>
                <description>Allow resizing task bars (MTO/K/O events are always move-only)</description>
            </property>
            <property key="allowGridReorder" type="boolean" required="true" defaultValue="true">
                <caption>Allow grid reorder</caption>
                <description>Show toolbar mode to drag child rows onto different parents in the grid</description>
            </property>
            <property key="readOnly" type="boolean" required="true" defaultValue="false">
                <caption>Read only</caption>
                <description>Disable all Gantt editing interactions</description>
            </property>
        </propertyGroup>
        <propertyGroup caption="Commands">
            <property key="command" type="attribute" required="false">
                <caption>Command</caption>
                <description>
                    Write a command name to control the Gantt from Mendix (e.g. FIT_TIMELINE, ZOOM_WEEK, EXPAND_ALL).
                    Clear the attribute after execute to allow re-triggering the same command.
                </description>
                <attributeTypes>
                    <attributeType name="String" />
                    <attributeType name="Enum" />
                </attributeTypes>
            </property>
            <property key="commandPayload" type="attribute" required="false">
                <caption>Command payload</caption>
                <description>
                    Optional JSON for commands that need data: SET_START_DATE / SET_END_DATE ({ "date": "ISO" }),
                    SCROLL_TO_TASK ({ "taskId": "..." }), or a plain task ID string.
                </description>
                <attributeTypes>
                    <attributeType name="String" />
                </attributeTypes>
            </property>
        </propertyGroup>
        <propertyGroup caption="Events">
            <property key="onEvent" type="action" required="false">
                <caption>On event</caption>
                <description>
                    Nanoflow or microflow executed when the Gantt emits an outgoing event (task click, add task, drag, reorder, etc.).
                    Read $eventType and $eventPayload attributes directly — no JavaScript required.
                </description>
            </property>
            <property key="eventType" type="attribute" required="false">
                <caption>Event type (out)</caption>
                <description>
                    Widget writes the event name here before calling On event.
                    Use in nanoflow to route logic:
                    TASK_CLICKED | TASK_DOUBLE_CLICKED | ADD_TASK_REQUESTED |
                    TASK_UPDATED | TASK_REORDERED | TASK_CREATED | TASK_DELETED |
                    VIEW_CHANGED | FULLSCREEN_CHANGED
                </description>
                <attributeTypes>
                    <attributeType name="String" />
                </attributeTypes>
            </property>
            <property key="eventPayload" type="attribute" required="false">
                <caption>Event payload (out)</caption>
                <description>
                    Widget writes JSON payload here before calling On event.
                    Parse in nanoflow: JSON.parse($eventPayload) gives { widgetId, type, data }.
                    data.task contains full GanttTask object for task events.
                </description>
                <attributeTypes>
                    <attributeType name="String" />
                </attributeTypes>
            </property>
        </propertyGroup>
    </properties>
</widget>
