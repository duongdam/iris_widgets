{
    "name": "iris-widgets",
    "private": true,
    "packageManager": "pnpm@10.30.0",
    "scripts": {
        "build": "pnpm -r run build",
        "postbuild": "node scripts/copy-mpk.mjs",
        "build:packages": "pnpm --filter './packages/*' run build",
        "build:widgets": "pnpm --filter './widgets/*' run build",
        "release:widgets": "pnpm --filter './widgets/*' run release && node scripts/copy-mpk.mjs",
        "test": "pnpm -r run test",
        "lint": "pnpm --filter './widgets/*' run lint",
        "lint:fix": "pnpm --filter './widgets/*' run lint:fix",
        "format": "pnpm --filter './widgets/*' run format",
        "clean": "pnpm -r run clean",
        "dev:barchart": "pnpm --filter ax-barchart run start",
        "dev:mock-ui": "pnpm --filter mock-ui run dev"
    },
    "devDependencies": {
        "@prettier/plugin-xml": "^1.2.0",
        "@typescript-eslint/eslint-plugin": "^8.53.0",
        "@typescript-eslint/parser": "^8.53.0",
        "autoprefixer": "^10.4.20",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^8.10.0",
        "eslint-plugin-jest": "^29.0.0",
        "eslint-plugin-prettier": "^3.4.1",
        "eslint-plugin-react": "^7.37.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "postcss": "^8.4.49",
        "postcss-import": "^16.1.0",
        "postcss-url": "^10.1.3",
        "prettier": "^2.8.8",
        "rollup-plugin-postcss": "^4.0.2",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.4.5"
    }
}
