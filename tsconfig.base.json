{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "composite": true,
        "isolatedModules": true,
        "paths": {
            "@iris/chart-core": ["./packages/chart-core/src/index.ts"],
            "@iris/chart-ui": ["./packages/chart-ui/src/index.ts"],
            "@iris/chart-echarts": ["./packages/chart-echarts/src/index.ts"],
            "@iris/form-core": ["./packages/form-core/src/index.ts"]
        }
    }
}
