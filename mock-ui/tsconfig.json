{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "preserveConstEnums": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "paths": {
            "@iris/chart-core": ["../packages/chart-core/src/index.ts"],
            "@iris/chart-ui": ["../packages/chart-ui/src/index.ts"],
            "@iris/chart-echarts": ["../packages/chart-echarts/src/index.ts"]
        }
    },
    "include": ["src"]
}
